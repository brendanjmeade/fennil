{
  "version": 8,
  "name": "Fennil Monochrome Terrain Bathymetry",
  "sources": {
    "composite": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v7,mapbox.mapbox-bathymetry-v1,mapbox.mapbox-terrain-v2,mslee.0fc2f90a"
    },
    "mapbox://mapbox.terrain-rgb": {
      "type": "raster-dem",
      "url": "mapbox://mapbox.terrain-rgb"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f2f2f2"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#ececec",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0,
          0.2,
          6,
          0.45,
          12,
          0.55
        ]
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "composite",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#e6e6e6",
        "fill-opacity": ["match", ["get", "class"], "snow", 0.8, 0.25]
      }
    },
    {
      "id": "terrain-hillshade",
      "type": "hillshade",
      "source": "mapbox://mapbox.terrain-rgb",
      "paint": {
        "hillshade-exaggeration": 0.5,
        "hillshade-shadow-color": "#8a8a8a",
        "hillshade-highlight-color": "#ffffff",
        "hillshade-accent-color": "#c8c8c8"
      }
    },
    {
      "id": "contour",
      "type": "line",
      "source": "composite",
      "source-layer": "contour",
      "paint": {
        "line-color": "#9a9a9a",
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          0.08,
          12,
          0.22,
          15,
          0.35
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          0.3,
          13,
          0.7,
          16,
          1.1
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": {
        "fill-color": "#d8d8d8"
      }
    },
    {
      "id": "bathymetry",
      "type": "fill",
      "source": "composite",
      "source-layer": "bathymetry",
      "maxzoom": 9,
      "paint": {
        "fill-color": "#7e7e7e",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["abs", ["get", "DEPTH"]],
          0,
          0,
          200,
          0.18,
          1000,
          0.28,
          3000,
          0.38,
          7000,
          0.5
        ]
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "composite",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#c3c3c3",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          0.25,
          12,
          0.8,
          18,
          1.4
        ]
      }
    }
  ]
}
